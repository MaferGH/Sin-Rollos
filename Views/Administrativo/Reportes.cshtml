@using WebApp.Models.Solicitudes
@model IEnumerable<Solicitud>

@{
    ViewData["Title"] = "Historial";
    Layout = "_LayoutAdministrador";
}

<style>
    .table-container-fixed {
        max-height: 400px;
        overflow-y: auto;
        overflow-x: auto;
        display: block;
    }
</style>

<h1 class="mb-4">Historial</h1>
<p class="text-muted">Consulta, filtra y descarga el historial de solicitudes internas completadas.</p>

<div class="card shadow mb-4">
    <div class="card-header bg-light">
        <h5>Filtros de Reporte</h5>
    </div>
    <div class="card-body">
        <form asp-controller="Administrativo" asp-action="Reportes" method="get">
            <div class="row g-3">

                <div class="col-md-4">
                    <label for="filtroDepartamento" class="form-label">Departamento</label>
                    <select id="filtroDepartamento" name="departamento" class="form-select">
                        <option value="">Todos los Departamentos</option>
                        <option value="Ventas" selected="@(ViewBag.FiltroDepartamento == "Ventas")">Ventas</option>
                        <option value="IT" selected="@(ViewBag.FiltroDepartamento == "IT")">IT</option>
                        <option value="RRHH" selected="@(ViewBag.FiltroDepartamento == "RRHH")">Recursos Humanos</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="filtroTipo" class="form-label">Tipo de Solicitud</label>
                    <select id="filtroTipo" name="tipoSolicitud" class="form-select">
                        <option value="">Todos los Tipos</option>
                        <option value="Viaticos" selected="@(ViewBag.FiltroTipo == "Viaticos")">Viáticos</option>
                        <option value="Permiso" selected="@(ViewBag.FiltroTipo == "Permiso")">Permiso</option>
                        <option value="Compra" selected="@(ViewBag.FiltroTipo == "Compra")">Compra de Equipo</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="filtroFechaInicio" class="form-label">Fecha Inicio</label>
                    <input type="date" id="filtroFechaInicio" name="fechaInicio" value="@ViewBag.FiltroInicio"
                        class="form-control">
                </div>

                <div class="col-md-4">
                    <label for="filtroFechaFin" class="form-label">Fecha Fin</label>
                    <input type="date" id="filtroFechaFin" name="fechaFin" value="@ViewBag.FiltroFin"
                        class="form-control">
                </div>

            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-filter"></i> Filtrar Solicitudes
                </button>
            </div>

        </form>
    </div>
</div>

<div class="card shadow mt-4">
    <div class="card-body table-container-fixed">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tipo</th>
                    <th>Departamento</th>
                    <th>Estado</th>
                    <th>Fecha Creación</th>
                    <th>Fecha Finalización</th>
                    <th>Tiempo Respuesta</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var solicitud in Model)
                    {
                        <tr>
                            <td>@solicitud.idSolicitud</td>
                            <td>@solicitud.tipoSolicitud</td>
                            <td>@solicitud.departamentosolicitado</td>

                            <td>
                                <span
                                    class="badge @(solicitud.estadoSolicitud == "Aprobada" ? "bg-success" :
                                                                                        (solicitud.estadoSolicitud == "Rechazada" ? "bg-danger" : "bg-warning"))">
                                    @solicitud.estadoSolicitud
                                </span>
                            </td>

                            <td>@solicitud.fechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>

                            <td>@(solicitud.fechaFinalizacion?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>

                            <td><strong>@solicitud.TiempoDeRespuesta</strong></td>

                            <td>
                                <a asp-controller="Administrativo" asp-action="DescargarPDF"
                                    asp-route-id="@solicitud.idSolicitud" class="btn btn-sm btn-info">
                                    PDF
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No se encontraron solicitudes.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINACIÓN -->
<nav aria-label="Paginación" class="mt-3">
    <ul class="pagination justify-content-center">

        <li class="page-item @(ViewBag.Page <= 1 ? "disabled" : "")">
            <a class="page-link" asp-route-page="@(ViewBag.Page - 1)"
                asp-route-departamento="@ViewBag.FiltroDepartamento" asp-route-tipoSolicitud="@ViewBag.FiltroTipo"
                asp-route-fechaInicio="@ViewBag.FiltroInicio" asp-route-fechaFin="@ViewBag.FiltroFin">
                Anterior
            </a>
        </li>

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                <a class="page-link" asp-route-page="@i" asp-route-departamento="@ViewBag.FiltroDepartamento"
                    asp-route-tipoSolicitud="@ViewBag.FiltroTipo" asp-route-fechaInicio="@ViewBag.FiltroInicio"
                    asp-route-fechaFin="@ViewBag.FiltroFin">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(ViewBag.Page >= ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-route-page="@(ViewBag.Page + 1)"
                asp-route-departamento="@ViewBag.FiltroDepartamento" asp-route-tipoSolicitud="@ViewBag.FiltroTipo"
                asp-route-fechaInicio="@ViewBag.FiltroInicio" asp-route-fechaFin="@ViewBag.FiltroFin">
                Siguiente
            </a>
        </li>

    </ul>
</nav>









