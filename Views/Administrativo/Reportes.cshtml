        html += `<div class="calendar-day" onclick="selectDate('${tipo}', ${day})">${day}</div>`;
    }

    html += `</div>`;
    popup.innerHTML = html;
}

function changeMonth(tipo, diff) {
    currentCalendars[tipo].setMonth(currentCalendars[tipo].getMonth() + diff);
