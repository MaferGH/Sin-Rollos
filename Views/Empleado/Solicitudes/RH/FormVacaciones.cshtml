
<div id="formVacaciones" class="tipo-form">
    <br>
    <hr>
    <br>
    <h5 class="mb-3 fw-bold">Vacaciones</h5>

    <div class="mb-3 row">
        <div class="col-md-6">
            <label for="anioIngreso" class="form-label">Año de ingreso</label>
            <input type="number" class="form-control" id="anioIngreso" name="anioIngreso" min="1900"
                max="@DateTime.Now.Year" placeholder="Ej. 2015" required>
        </div>
        <div class="col-md-6">
            <label for="diasVacaciones" class="form-label">Días solicitados</label>
            <input type="number" class="form-control" id="diasVacaciones" name="diasVacaciones" min="1" required>
        </div>
    </div>

    <div class="mb-3 row">
        <div class="col-md-6">
            <label for="fechaInicio" class="form-label">Fecha de inicio</label>
            <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" required>
        </div>

        <div class="col-md-6">
            <label for="fechaRegreso" class="form-label">Fecha de regreso</label>
            <input type="date" class="form-control" id="fechaRegreso" name="fechaRegreso" required>
        </div>
    </div>

    <div class="mb-3">
        <label for="comentariosVacaciones" class="form-label">Motivo</label>
        <textarea class="form-control" id="comentariosVacaciones" name="comentariosVacaciones" rows="3"
            placeholder="Agregar algún detalle..."></textarea>
    </div>
</div>

